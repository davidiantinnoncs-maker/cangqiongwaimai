<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.SetmealDishMapper">

    <insert id="insertBatch" parameterType="java.util.List">
        insert into setmeal_dish (setmeal_id, dish_id, name, price, copies) values
        <foreach collection="list" item="sd" separator=",">
            (#{sd.setmealId}, #{sd.dishId}, #{sd.name}, #{sd.price}, #{sd.copies})
        </foreach>
    </insert>

    <delete id="deleteBySetmealId" parameterType="java.lang.Long">
        delete from setmeal_dish where setmeal_id = #{setmealId}
    </delete>

    <delete id="deleteBySetmealIds" parameterType="java.util.List">
        delete from setmeal_dish where setmeal_id in
        <foreach collection="list" item="setmealId" open="(" separator="," close=")">
            #{setmealId}
        </foreach>
    </delete>

    <select id="getBySetmealId" resultType="com.sky.entity.SetmealDish">
        select * from setmeal_dish where setmeal_id = #{setmealId}
    </select>

    <select id="getDishIdsBySetmealId" resultType="java.lang.Long">
        select dish_id from setmeal_dish where setmeal_id = #{setmealId}
    </select>

    <select id="countByDishIds" resultType="java.lang.Integer">
        select count(id) from setmeal_dish where dish_id in
        <foreach collection="list" item="dishId" open="(" separator="," close=")">
            #{dishId}
        </foreach>
    </select>

</mapper>
